<?xml version="1.0" encoding="utf-8"?>
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:scrollbars="none"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/americasButton"
                    android:background="@drawable/bg_test_americas"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Arkham - San Francisco - Buenos Aires"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/europeButton"
                    android:background="@drawable/bg_europe"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="London - Rome - Istanbul"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/asiaButton"
                    android:background="@drawable/bg_asia"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Shanghai - Tokyo - Sydney"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/antWestButton"
                    android:background="@drawable/bg_city"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="City of the Elder Things - Plateau of Leng - Snowy Mountains"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/antEastButton"
                    android:background="@drawable/bg_frozen_waste"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Frozen Waste - Lake Camp - Miskatonic Outpost"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/africa"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/africaButton"
                    android:background="@drawable/bg_sahara"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="The Sahara Desert - Tel el-Amarna - The Nile River"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/africa"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/egyptButton"
                    android:background="@drawable/bg_alexandria"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Alexandria - The Bent Pyramid - Cairo"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/dreamland_s"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/dreamlandsButton"
                    android:background="@drawable/bg_celephais"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Celephaïs - Ulthar - Dylath-Leen"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/city_wilderness"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/generalButton"
                    android:background="@drawable/bg_city_wilderness"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="City - Wilderness - Sea"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/gate"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/gateButton"
                    android:background="@drawable/bg_gate"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Gate"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/expLayout"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="10dp"
                android:weightSum="6">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="4">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/neighbourhood"
                        android:scaleType="fitXY"
                        android:alpha="0.5"/>
                    <Button
                        android:textSize="20dp"
                        android:textColor="#ffffffff"
                        android:id="@+id/expeditionButton"
                        android:background="@drawable/bg_expedition"
                        android:layout_width="match_parent"
                        android:layout_height="75dp"
                        android:text="Expedition [LOCATION]"
                        android:onClick="drawCard"/>
                </FrameLayout>
                <Button
                    android:textSize="20dp"
                    android:id="@+id/removeButton"
                    android:background="#80cccccc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Remove"
                    android:singleLine="true"
                    android:layout_weight="2"
                    android:onClick="removeExpedition"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/mysticRuinsButton"
                    android:background="@drawable/bg_mystic_ruins"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Mystic Ruins [LOCATION]"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/dreamQuestButton"
                    android:background="@drawable/bg_dreams_quest"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Dream-Quest [LOCATION]"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/researchButton"
                    android:background="#80000000"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Research"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/antResearchButton"
                    android:background="#808b4512"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Antarctica Research"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/special1Button"
                    android:background="#80578b84"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Special-1"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/special2Button"
                    android:background="#802c8b5e"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Special-2"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/special3Button"
                    android:background="#80075e35"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Special-3"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/disasterButton"
                    android:background="@android:color/holo_blue_dark"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Disaster"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/devastationButton"
                    android:background="@android:color/holo_red_light"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Devastation"
                    android:onClick="drawCard"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/neighbourhood"
                    android:scaleType="fitXY"
                    android:alpha="0.5"/>
                <Button
                    android:textSize="20dp"
                    android:textColor="#ffffffff"
                    android:id="@+id/discardButton"
                    android:background="#ff3d4876"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:text="Discard"
                    android:onClick="drawCard"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
